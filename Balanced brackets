def is_balanced(text):
  pairs = {")": "(", "]": "[", "}": "{"}
  stack = []
  # opening bracket: push. closing bracket: pop and check it matches
  for char in text:
    if char in pairs.values():
      stack.append(char)
    elif char in pairs:
      if not stack or stack.pop() != pairs[char]:
        return False
  return len(stack) == 0


print(is_balanced("(a[b]{c})"))
